# Copy these values into your host's dashboard (PythonAnywhere: Web tab ->
# "Environment variables"). This file is only a reference; the app reads real
# environment variables, it does not load .env automatically.

# Stable session key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Bootstraps the main admin account the first time the database is created.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Job log timestamps are stored in this timezone.
APP_TIMEZONE=Asia/Dhaka

# Set to 1 only when the site is served over HTTPS.
SESSION_COOKIE_SECURE=0

# Optional overrides. Defaults: <project>/records.db, 0.0.0.0, 5000.
# DATABASE_PATH=
# FLASK_HOST=0.0.0.0
# FLASK_PORT=5000
