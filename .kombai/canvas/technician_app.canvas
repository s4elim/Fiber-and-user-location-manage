      "html": "<link data-kid=\"1\" data-name=\"Leaflet map stylesheet\" href=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.css\" rel=\"stylesheet\"/>\n<link data-kid=\"2\" data-name=\"Tabler icons webfont stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');\n  .bn { font-family: 'Hind Siliguri', ui-sans-serif, system-ui, sans-serif; }\n  .mono { font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace; font-variant-numeric: tabular-nums; }\n  #map { height: 196px; background-color: #eef2f6; background-image: linear-gradient(#e2e8f0 1px, transparent 1px), linear-gradient(90deg, #e2e8f0 1px, transparent 1px); background-size: 26px 26px; z-index: 0; }\n  .leaflet-container { font-family: 'Hind Siliguri', sans-serif; }\n</style>\n<div class=\"bn min-h-screen bg-slate-100 pb-6 text-slate-800\" data-kid=\"3\" data-name=\"page layout container\">\n<div class=\"mx-auto w-full max-w-[430px] px-3 pt-4\" data-kid=\"3-1\" data-name=\"centered mobile app container\">\n<header class=\"mb-3.5 flex items-start justify-between\" data-kid=\"3-1-1\" data-name=\"page header with title and admin link\">\n<div data-kid=\"3-1-1-1\" data-name=\"header title block\">\n<h1 class=\"text-[21px] font-bold leading-tight text-slate-900\" data-kid=\"3-1-1-1-1\" data-name=\"page title heading\">ফিল্ড লগ</h1>\n<p class=\"mt-0.5 text-[11.5px] text-slate-500\" data-kid=\"3-1-1-1-2\" data-name=\"page subtitle description\">কাজের লোকেশন ও ফাইবারের হিসাব</p>\n</div>\n<a class=\"mt-0.5 rounded-md border border-slate-300 bg-white px-2 py-1 text-[10.5px] font-medium text-slate-600\" data-kid=\"3-1-1-2\" data-name=\"admin access button\" href=\"#\">Admin</a>\n</header>\n<form class=\"space-y-3.5 rounded-2xl border border-slate-200 bg-white p-3.5 shadow-sm\" data-kid=\"3-1-2\" data-name=\"log entry form card\">\n<fieldset data-kid=\"3-1-2-1\" data-name=\"work type selector fieldset\">\n<legend class=\"mb-2 text-[12px] font-semibold text-slate-700\" data-kid=\"3-1-2-1-1\" data-name=\"work type section heading\">কাজের ধরন</legend>\n<div class=\"grid grid-cols-2 gap-2\" data-kid=\"3-1-2-1-2\" data-name=\"work type radio options grid\">\n<label class=\"flex cursor-pointer items-center justify-center gap-2 rounded-xl border-2 border-slate-200 bg-white px-2.5 py-2.5 text-[13px] font-medium text-slate-600\" data-kid=\"3-1-2-1-2-1\" data-name=\"team user radio option card\">\n<input class=\"h-4 w-4 accent-blue-600\" data-kid=\"3-1-2-1-2-1-1\" data-name=\"team user radio input\" name=\"work_type\" type=\"radio\" value=\"Customer\"/>\n            টিম ইউজার\n          </label>\n<label class=\"flex cursor-pointer items-center justify-center gap-2 rounded-xl border-2 border-blue-600 bg-blue-50 px-2.5 py-2.5 text-[13px] font-semibold text-blue-800\" data-kid=\"3-1-2-1-2-2\" data-name=\"TJ box radio option card (selected)\">\n<input checked=\"\" class=\"h-4 w-4 accent-blue-600\" data-kid=\"3-1-2-1-2-2-1\" data-name=\"TJ box radio input\" name=\"work_type\" type=\"radio\" value=\"TJ Box\"/>\n            TJ Box\n          </label>\n</div>\n</fieldset>\n<section class=\"overflow-hidden rounded-xl border border-slate-200\" data-kid=\"3-1-2-2\" data-name=\"map location section\">\n<div class=\"flex items-center justify-between px-3 py-2.5\" data-kid=\"3-1-2-2-1\" data-name=\"map section header row\">\n<span class=\"flex items-center gap-1.5 text-[12px] font-semibold text-slate-800\" data-kid=\"3-1-2-2-1-1\" data-name=\"location label\">\n<i class=\"ti ti-map-pin text-[15px] text-blue-700\" data-kid=\"3-1-2-2-1-1-1\" data-name=\"map pin icon\"></i>\n            লোকেশন\n          </span>\n<button class=\"flex items-center gap-1.5 rounded-lg bg-blue-600 px-2.5 py-1.5 text-[10.5px] font-semibold text-white shadow-sm\" data-kid=\"3-1-2-2-1-2\" data-name=\"fetch current GPS button\" type=\"button\">\n<i class=\"ti ti-current-location text-[13px]\" data-kid=\"3-1-2-2-1-2-1\" data-name=\"current location icon\"></i>\n            বর্তমান GPS\n          </button>\n</div>\n<div class=\"relative\" data-kid=\"3-1-2-2-2\" data-name=\"map display container\">\n<div class=\"w-full\" data-dynamic=\"true\" data-kid=\"3-1-2-2-2-1\" data-name=\"interactive map container\" data-reason=\"map initialized by Leaflet script which injects children\" id=\"map\"></div>\n<span class=\"pointer-events-none absolute right-2 top-2 flex items-center gap-1 rounded-md bg-white/95 px-1.5 py-1 text-[9.5px] font-medium text-slate-600 shadow-sm ring-1 ring-slate-200\" data-kid=\"3-1-2-2-2-2\" data-name=\"map tap hint badge\">\n<i class=\"ti ti-hand-finger text-[11px] text-blue-700\" data-kid=\"3-1-2-2-2-2-1\" data-name=\"hand pointer icon\"></i>\n            ম্যাপে ট্যাপ করে বিন্দু বদলান\n          </span>\n</div>\n<div class=\"border-t border-dashed border-slate-300 bg-white px-3 py-2.5\" data-kid=\"3-1-2-2-3\" data-name=\"selected coordinates detail row\">\n<div class=\"flex items-center justify-between\" data-kid=\"3-1-2-2-3-1\" data-name=\"coordinates header with accuracy\">\n<span class=\"flex items-center gap-1 text-[9.5px] font-semibold text-slate-400\" data-kid=\"3-1-2-2-3-1-1\" data-name=\"selected point label\">\n<i class=\"ti ti-crosshair text-[12px]\" data-kid=\"3-1-2-2-3-1-1-1\" data-name=\"crosshair icon\"></i>\n              নির্বাচিত বিন্দু\n            </span>\n<span class=\"flex items-center gap-1 text-[9.5px] font-semibold text-emerald-700\" data-kid=\"3-1-2-2-3-1-2\" data-name=\"accuracy indicator\">\n<span class=\"h-1.5 w-1.5 rounded-full bg-emerald-500\" data-kid=\"3-1-2-2-3-1-2-1\" data-name=\"green accuracy dot\"></span>\n              ±12 মিটার\n            </span>\n</div>\n<div class=\"mt-1.5 grid grid-cols-2\" data-kid=\"3-1-2-2-3-2\" data-name=\"coordinate values grid\">\n<div class=\"pr-3\" data-kid=\"3-1-2-2-3-2-1\" data-name=\"latitude field\">\n<p class=\"text-[9.5px] text-slate-400\" data-kid=\"3-1-2-2-3-2-1-1\" data-name=\"latitude label\">অক্ষাংশ</p>\n<p class=\"mono mt-0.5 text-[15px] font-semibold leading-none text-slate-900\" data-kid=\"3-1-2-2-3-2-1-2\" data-name=\"latitude value\">23.810273</p>\n</div>\n<div class=\"border-l border-slate-100 pl-3\" data-kid=\"3-1-2-2-3-2-2\" data-name=\"longitude field\">\n<p class=\"text-[9.5px] text-slate-400\" data-kid=\"3-1-2-2-3-2-2-1\" data-name=\"longitude label\">দ্রাঘিমাংশ</p>\n<p class=\"mono mt-0.5 text-[15px] font-semibold leading-none text-slate-900\" data-kid=\"3-1-2-2-3-2-2-2\" data-name=\"longitude value\">90.412533</p>\n</div>\n</div>\n</div>\n</section>\n<details class=\"overflow-hidden rounded-xl border border-slate-200\" data-kid=\"3-1-2-3\" data-name=\"more options collapsible panel\" open=\"\">\n<summary class=\"flex cursor-pointer list-none items-center justify-between px-3 py-2.5 [&amp;::-webkit-details-marker]:hidden\" data-kid=\"3-1-2-3-1\" data-name=\"collapsible panel summary header\">\n<span class=\"flex items-center gap-1.5\" data-kid=\"3-1-2-3-1-1\" data-name=\"summary title and badge wrapper\">\n<span class=\"text-[12px] font-semibold text-slate-800\" data-kid=\"3-1-2-3-1-1-1\" data-name=\"more options title\">More options</span>\n<span class=\"rounded-full bg-slate-100 px-1.5 py-0.5 text-[9px] font-semibold text-slate-500\" data-kid=\"3-1-2-3-1-1-2\" data-name=\"filled count badge\">৪টি ভরা</span>\n</span>\n<i class=\"ti ti-chevron-up text-[15px] text-slate-400\" data-kid=\"3-1-2-3-1-2\" data-name=\"chevron up icon\"></i>\n</summary>\n<div class=\"space-y-3.5 border-t border-slate-100 px-3 py-3\" data-kid=\"3-1-2-3-2\" data-name=\"collapsible panel content\">\n<div data-kid=\"3-1-2-3-2-1\" data-name=\"splitter selector\">\n<p class=\"text-[11px] font-semibold text-slate-700\" data-kid=\"3-1-2-3-2-1-1\" data-name=\"splitter label\">Splitter</p>\n<div class=\"mt-1 flex items-center justify-between rounded-lg border border-slate-300 bg-white px-2.5 py-2\" data-kid=\"3-1-2-3-2-1-2\" data-name=\"splitter ratio dropdown\">\n<span class=\"text-[12px] font-medium text-slate-800\" data-kid=\"3-1-2-3-2-1-2-1\" data-name=\"splitter ratio value\">1:8</span>\n<i class=\"ti ti-chevron-down text-[13px] text-slate-400\" data-kid=\"3-1-2-3-2-1-2-2\" data-name=\"dropdown chevron icon\"></i>\n</div>\n</div>\n<div data-kid=\"3-1-2-3-2-2\" data-name=\"fiber pairs section\">\n<div class=\"mb-2 flex items-center justify-between\" data-kid=\"3-1-2-3-2-2-1\" data-name=\"fiber pairs header\">\n<span class=\"text-[11px] font-semibold text-slate-700\" data-kid=\"3-1-2-3-2-2-1-1\" data-name=\"fiber pairs label\">জোড়া / কোর</span>\n<button class=\"flex items-center gap-1 rounded-md border border-blue-200 bg-blue-50 px-2 py-1 text-[10px] font-semibold text-blue-700\" data-kid=\"3-1-2-3-2-2-1-2\" data-name=\"add pair button\" type=\"button\">\n<i class=\"ti ti-plus text-[11px]\" data-kid=\"3-1-2-3-2-2-1-2-1\" data-name=\"plus icon\"></i>\n                যোগ\n              </button>\n</div>\n<div class=\"space-y-2\" data-kid=\"3-1-2-3-2-2-2\" data-name=\"fiber pairs list\">\n<div class=\"rounded-lg border border-slate-200 bg-slate-50/70 p-2.5\" data-kid=\"3-1-2-3-2-2-2-1\" data-name=\"first fiber pair card\">\n<div class=\"mb-2 flex items-center justify-between\" data-kid=\"3-1-2-3-2-2-2-1-1\" data-name=\"pair card header\">\n<span class=\"flex items-center gap-1.5 text-[10.5px] font-semibold text-slate-600\" data-kid=\"3-1-2-3-2-2-2-1-1-1\" data-name=\"pair number and label\">\n<span class=\"mono flex h-4 w-4 items-center justify-center rounded bg-white text-[9px] font-bold text-slate-500 ring-1 ring-slate-200\" data-kid=\"3-1-2-3-2-2-2-1-1-1-1\" data-name=\"pair number badge\">১</span>\n                    জোড়া\n                  </span>\n<button class=\"text-[10px] font-medium text-red-600\" data-kid=\"3-1-2-3-2-2-2-1-1-2\" data-name=\"delete pair button\" type=\"button\">বাদ</button>\n</div>\n<div class=\"grid grid-cols-2 gap-2\" data-kid=\"3-1-2-3-2-2-2-1-2\" data-name=\"pair color selector grid\">\n<div data-kid=\"3-1-2-3-2-2-2-1-2-1\" data-name=\"input fiber color field\">\n<p class=\"text-[9px] text-slate-500\" data-kid=\"3-1-2-3-2-2-2-1-2-1-1\" data-name=\"input fiber label\">ইনপুট ফাইবার</p>\n<div class=\"mt-1 flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-1.5 py-1.5\" data-kid=\"3-1-2-3-2-2-2-1-2-1-2\" data-name=\"input color dropdown\">\n<span class=\"h-2.5 w-2.5 shrink-0 rounded-full bg-blue-600\" data-kid=\"3-1-2-3-2-2-2-1-2-1-2-1\" data-name=\"blue color dot\"></span>\n<span class=\"text-[10.5px] font-medium text-slate-700\" data-kid=\"3-1-2-3-2-2-2-1-2-1-2-2\" data-name=\"input color name\">নীল</span>\n<i class=\"ti ti-chevron-down ml-auto text-[10px] text-slate-400\" data-kid=\"3-1-2-3-2-2-2-1-2-1-2-3\" data-name=\"dropdown chevron icon\"></i>\n</div>\n</div>\n<div data-kid=\"3-1-2-3-2-2-2-1-2-2\" data-name=\"output fiber color field\">\n<p class=\"text-[9px] text-slate-500\" data-kid=\"3-1-2-3-2-2-2-1-2-2-1\" data-name=\"output fiber label\">আউটপুট ফাইবার</p>\n<div class=\"mt-1 flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-1.5 py-1.5\" data-kid=\"3-1-2-3-2-2-2-1-2-2-2\" data-name=\"output color dropdown\">\n<span class=\"h-2.5 w-2.5 shrink-0 rounded-full bg-orange-500\" data-kid=\"3-1-2-3-2-2-2-1-2-2-2-1\" data-name=\"orange color dot\"></span>\n<span class=\"text-[10.5px] font-medium text-slate-700\" data-kid=\"3-1-2-3-2-2-2-1-2-2-2-2\" data-name=\"output color name\">কমলা</span>\n<i class=\"ti ti-chevron-down ml-auto text-[10px] text-slate-400\" data-kid=\"3-1-2-3-2-2-2-1-2-2-2-3\" data-name=\"dropdown chevron icon\"></i>\n</div>\n</div>\n</div>\n<div class=\"mt-2 flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-2 py-1.5\" data-kid=\"3-1-2-3-2-2-2-1-3\" data-name=\"pair location note\">\n<i class=\"ti ti-map-pin text-[12px] text-slate-400\" data-kid=\"3-1-2-3-2-2-2-1-3-1\" data-name=\"map pin icon\"></i>\n<span class=\"text-[10.5px] text-slate-700\" data-kid=\"3-1-2-3-2-2-2-1-3-2\" data-name=\"pair location text\">টিজে-৩, পোর্ট ৪</span>\n</div>\n</div>\n<div class=\"rounded-lg border border-slate-200 bg-slate-50/70 p-2.5\" data-kid=\"3-1-2-3-2-2-2-2\" data-name=\"second fiber pair card\">\n<div class=\"mb-2 flex items-center justify-between\" data-kid=\"3-1-2-3-2-2-2-2-1\" data-name=\"second pair header\">\n<span class=\"flex items-center gap-1.5 text-[10.5px] font-semibold text-slate-600\" data-kid=\"3-1-2-3-2-2-2-2-1-1\" data-name=\"second pair number and label\">\n<span class=\"mono flex h-4 w-4 items-center justify-center rounded bg-white text-[9px] font-bold text-slate-500 ring-1 ring-slate-200\" data-kid=\"3-1-2-3-2-2-2-2-1-1-1\" data-name=\"second pair number badge\">২</span>\n                    জোড়া\n                  </span>\n<button class=\"text-[10px] font-medium text-red-600\" data-kid=\"3-1-2-3-2-2-2-2-1-2\" data-name=\"delete pair button\" type=\"button\">বাদ</button>\n</div>\n<div class=\"grid grid-cols-2 gap-2\" data-kid=\"3-1-2-3-2-2-2-2-2\" data-name=\"second pair color selector grid\">\n<div data-kid=\"3-1-2-3-2-2-2-2-2-1\" data-name=\"second pair input fiber field\">\n<p class=\"text-[9px] text-slate-500\" data-kid=\"3-1-2-3-2-2-2-2-2-1-1\" data-name=\"input fiber label\">ইনপুট ফাইবার</p>\n<div class=\"mt-1 flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-1.5 py-1.5\" data-kid=\"3-1-2-3-2-2-2-2-2-1-2\" data-name=\"input color dropdown\">\n<span class=\"h-2.5 w-2.5 shrink-0 rounded-full bg-green-600\" data-kid=\"3-1-2-3-2-2-2-2-2-1-2-1\" data-name=\"green color dot\"></span>\n<span class=\"text-[10.5px] font-medium text-slate-700\" data-kid=\"3-1-2-3-2-2-2-2-2-1-2-2\" data-name=\"input color name\">সবুজ</span>\n<i class=\"ti ti-chevron-down ml-auto text-[10px] text-slate-400\" data-kid=\"3-1-2-3-2-2-2-2-2-1-2-3\" data-name=\"dropdown chevron icon\"></i>\n</div>\n</div>\n<div data-kid=\"3-1-2-3-2-2-2-2-2-2\" data-name=\"second pair output fiber field\">\n<p class=\"text-[9px] text-slate-500\" data-kid=\"3-1-2-3-2-2-2-2-2-2-1\" data-name=\"output fiber label\">আউটপুট ফাইবার</p>\n<div class=\"mt-1 flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-1.5 py-1.5\" data-kid=\"3-1-2-3-2-2-2-2-2-2-2\" data-name=\"output color dropdown\">\n<span class=\"h-2.5 w-2.5 shrink-0 rounded-full bg-amber-800\" data-kid=\"3-1-2-3-2-2-2-2-2-2-2-1\" data-name=\"brown color dot\"></span>\n<span class=\"text-[10.5px] font-medium text-slate-700\" data-kid=\"3-1-2-3-2-2-2-2-2-2-2-2\" data-name=\"output color name\">বাদামি</span>\n<i class=\"ti ti-chevron-down ml-auto text-[10px] text-slate-400\" data-kid=\"3-1-2-3-2-2-2-2-2-2-2-3\" data-name=\"dropdown chevron icon\"></i>\n</div>\n</div>\n</div>\n<div class=\"mt-2 flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-2 py-1.5\" data-kid=\"3-1-2-3-2-2-2-2-3\" data-name=\"second pair location note\">\n<i class=\"ti ti-map-pin text-[12px] text-slate-400\" data-kid=\"3-1-2-3-2-2-2-2-3-1\" data-name=\"map pin icon\"></i>\n<span class=\"text-[10.5px] text-slate-700\" data-kid=\"3-1-2-3-2-2-2-2-3-2\" data-name=\"second pair location text\">টিজে-৫, পোর্ট ৯</span>\n</div>\n</div>\n</div>\n</div>\n<fieldset data-kid=\"3-1-2-3-2-3\" data-name=\"fiber reading fieldset\">\n<legend class=\"text-[11px] font-semibold text-slate-700\" data-kid=\"3-1-2-3-2-3-1\" data-name=\"fiber reading legend\">ফাইবার রিডিং (মিটার)</legend>\n<div class=\"mt-1.5 grid grid-cols-2 gap-2\" data-kid=\"3-1-2-3-2-3-2\" data-name=\"reading values grid\">\n<div class=\"rounded-lg border border-slate-300 bg-white px-2.5 py-1.5\" data-kid=\"3-1-2-3-2-3-2-1\" data-name=\"start reading field\">\n<p class=\"text-[9px] text-slate-500\" data-kid=\"3-1-2-3-2-3-2-1-1\" data-name=\"start label\">শুরু</p>\n<p class=\"mono mt-0.5 text-[12.5px] font-medium text-slate-800\" data-kid=\"3-1-2-3-2-3-2-1-2\" data-name=\"start reading value\">1250</p>\n</div>\n<div class=\"rounded-lg border border-slate-300 bg-white px-2.5 py-1.5\" data-kid=\"3-1-2-3-2-3-2-2\" data-name=\"end reading field\">\n<p class=\"text-[9px] text-slate-500\" data-kid=\"3-1-2-3-2-3-2-2-1\" data-name=\"end label\">শেষ</p>\n<p class=\"mono mt-0.5 text-[12.5px] font-medium text-slate-800\" data-kid=\"3-1-2-3-2-3-2-2-2\" data-name=\"end reading value\">1295</p>\n</div>\n</div>\n<div class=\"mt-2 flex items-center justify-between rounded-lg bg-blue-50 px-2.5 py-1.5\" data-kid=\"3-1-2-3-2-3-3\" data-name=\"total usage summary row\">\n<span class=\"text-[10px] text-slate-600\" data-kid=\"3-1-2-3-2-3-3-1\" data-name=\"total usage label\">মোট ব্যবহৃত</span>\n<span class=\"mono text-[12px] font-semibold text-blue-800\" data-kid=\"3-1-2-3-2-3-3-2\" data-name=\"total usage value\">45 মিটার</span>\n</div>\n</fieldset>\n<div data-kid=\"3-1-2-3-2-4\" data-name=\"notes section\">\n<p class=\"text-[11px] font-semibold text-slate-700\" data-kid=\"3-1-2-3-2-4-1\" data-name=\"notes label\">মন্তব্য / নোট</p>\n<div class=\"mt-1 flex min-h-[46px] items-start rounded-lg border border-slate-300 bg-white px-2.5 py-2 text-[11px] leading-relaxed text-slate-600\" data-kid=\"3-1-2-3-2-4-2\" data-name=\"notes content box\">পোল থেকে ২০ মিটার দূরে বক্স বসানো হয়েছে। কভার লাগানো আছে।</div>\n</div>\n</div>\n</details>\n<div class=\"rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-2\" data-kid=\"3-1-2-4\" data-name=\"device info panel\">\n<div class=\"flex items-center gap-1.5\" data-kid=\"3-1-2-4-1\" data-name=\"device info header\">\n<i class=\"ti ti-device-mobile text-[13px] text-slate-500\" data-kid=\"3-1-2-4-1-1\" data-name=\"mobile device icon\"></i>\n<span class=\"text-[9.5px] font-semibold text-slate-500\" data-kid=\"3-1-2-4-1-2\" data-name=\"device info notice text\">এই এন্ট্রির সাথে ডিভাইস তথ্য যুক্ত হবে</span>\n</div>\n<div class=\"mt-1.5 grid grid-cols-3 divide-x divide-slate-200\" data-kid=\"3-1-2-4-2\" data-name=\"device info row grid\">\n<div class=\"pr-2\" data-kid=\"3-1-2-4-2-1\" data-name=\"device name field\">\n<p class=\"text-[8.5px] text-slate-400\" data-kid=\"3-1-2-4-2-1-1\" data-name=\"device label\">ডিভাইস</p>\n<p class=\"mono mt-0.5 text-[9.5px] font-medium text-slate-700\" data-kid=\"3-1-2-4-2-1-2\" data-name=\"device model value\">Redmi Note 12</p>\n</div>\n<div class=\"px-2\" data-kid=\"3-1-2-4-2-2\" data-name=\"OS field\">\n<p class=\"text-[8.5px] text-slate-400\" data-kid=\"3-1-2-4-2-2-1\" data-name=\"OS label\">OS</p>\n<p class=\"mono mt-0.5 text-[9.5px] font-medium text-slate-700\" data-kid=\"3-1-2-4-2-2-2\" data-name=\"OS version value\">Android 14</p>\n</div>\n<div class=\"pl-2\" data-kid=\"3-1-2-4-2-3\" data-name=\"browser field\">\n<p class=\"text-[8.5px] text-slate-400\" data-kid=\"3-1-2-4-2-3-1\" data-name=\"browser label\">ব্রাউজার</p>\n<p class=\"mono mt-0.5 text-[9.5px] font-medium text-slate-700\" data-kid=\"3-1-2-4-2-3-2\" data-name=\"browser version value\">Chrome 143</p>\n</div>\n</div>\n<div class=\"mt-1.5 grid grid-cols-2 divide-x divide-slate-200 border-t border-slate-200 pt-1.5\" data-kid=\"3-1-2-4-3\" data-name=\"device info second row grid\">\n<div class=\"pr-2\" data-kid=\"3-1-2-4-3-1\" data-name=\"screen size field\">\n<p class=\"text-[8.5px] text-slate-400\" data-kid=\"3-1-2-4-3-1-1\" data-name=\"screen label\">স্ক্রিন</p>\n<p class=\"mono mt-0.5 text-[9.5px] font-medium text-slate-700\" data-kid=\"3-1-2-4-3-1-2\" data-name=\"screen dimension value\">412×915 px</p>\n</div>\n<div class=\"pl-2\" data-kid=\"3-1-2-4-3-2\" data-name=\"IP address field\">\n<p class=\"text-[8.5px] text-slate-400\" data-kid=\"3-1-2-4-3-2-1\" data-name=\"IP label\">IP</p>\n<p class=\"mono mt-0.5 text-[9.5px] font-medium text-slate-700\" data-kid=\"3-1-2-4-3-2-2\" data-name=\"IP address value\">103.108.24.17</p>\n</div>\n</div>\n</div>\n<button class=\"w-full rounded-xl bg-blue-600 py-3 text-[14px] font-bold text-white shadow-sm\" data-kid=\"3-1-2-5\" data-name=\"save entry submit button\" type=\"submit\">সেভ করুন</button>\n</form>\n</div>\n</div>\n<script src=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.js\"></script>\n<script>\n  (function () {\n    const point = [23.810273, 90.412533];\n    const map = L.map('map', { zoomControl: false, attributionControl: true, scrollWheelZoom: false }).setView(point, 17);\n    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '&copy; OpenStreetMap' }).addTo(map);\n    L.circle(point, { radius: 35, color: '#2563eb', weight: 1, opacity: 0.35, fillColor: '#2563eb', fillOpacity: 0.08 }).addTo(map);\n    L.circleMarker(point, { radius: 7, color: '#ffffff', weight: 3, fillColor: '#2563eb', fillOpacity: 1 }).addTo(map);\n  })();\n</script>",
