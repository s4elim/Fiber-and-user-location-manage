      "html": "<link data-kid=\"1\" data-name=\"Leaflet map stylesheet link\" href=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.css\" rel=\"stylesheet\"/>\n<link data-kid=\"2\" data-name=\"Tabler icons webfont stylesheet link\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');\n  .bn { font-family: 'Hind Siliguri', ui-sans-serif, system-ui, sans-serif; }\n  .mono { font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace; font-variant-numeric: tabular-nums; }\n  #map { height: 196px; background-color: #eef2f6; background-image: linear-gradient(#e2e8f0 1px, transparent 1px), linear-gradient(90deg, #e2e8f0 1px, transparent 1px); background-size: 26px 26px; z-index: 0; }\n  .leaflet-container { font-family: 'Hind Siliguri', sans-serif; }\n</style>\n<div class=\"bn min-h-screen bg-slate-100 pb-6 text-slate-800\" data-kid=\"3\" data-name=\"mobile page layout container\">\n<div class=\"mx-auto w-full max-w-[430px] px-3 pt-4\" data-kid=\"3-1\" data-name=\"max-width app card container\">\n<header class=\"mb-3.5 flex items-start justify-between\" data-kid=\"3-1-1\" data-name=\"page header with title and admin link\">\n<div data-kid=\"3-1-1-1\" data-name=\"header title group container\">\n<h1 class=\"text-[21px] font-bold leading-tight text-slate-900\" data-kid=\"3-1-1-1-1\" data-name=\"app headline title\">ফিল্ড লগ</h1>\n<p class=\"mt-0.5 text-[11.5px] text-slate-500\" data-kid=\"3-1-1-1-2\" data-name=\"app subtitle description text\">কাজের লোকেশন ও ফাইবারের হিসাব</p>\n</div>\n<a class=\"mt-0.5 rounded-md border border-slate-300 bg-white px-2 py-1 text-[10.5px] font-medium text-slate-600\" data-kid=\"3-1-1-2\" data-name=\"admin navigation link\" href=\"#\">Admin</a>\n</header>\n<form class=\"space-y-3.5 rounded-2xl border border-slate-200 bg-white p-3.5 shadow-sm\" data-kid=\"3-1-2\" data-name=\"field log entry form card\">\n<fieldset data-kid=\"3-1-2-1\" data-name=\"work type radio fieldset\">\n<legend class=\"mb-2 text-[12px] font-semibold text-slate-700\" data-kid=\"3-1-2-1-1\" data-name=\"work type fieldset legend\">কাজের ধরন</legend>\n<div class=\"grid grid-cols-2 gap-2\" data-kid=\"3-1-2-1-2\" data-name=\"work type radio grid\">\n<label class=\"flex cursor-pointer items-center justify-center gap-2 rounded-xl border-2 border-blue-600 bg-blue-50 px-2.5 py-2.5 text-[13px] font-semibold text-blue-800\" data-kid=\"3-1-2-1-2-1\" data-name=\"work type selected radio card\">\n<input checked=\"\" class=\"h-4 w-4 accent-blue-600\" data-kid=\"3-1-2-1-2-1-1\" data-name=\"work type radio input\" name=\"work_type\" type=\"radio\" value=\"Customer\"/>\n            টিম ইউজার\n          </label>\n<label class=\"flex cursor-pointer items-center justify-center gap-2 rounded-xl border-2 border-slate-200 bg-white px-2.5 py-2.5 text-[13px] font-medium text-slate-600\" data-kid=\"3-1-2-1-2-2\" data-name=\"work type unselected radio card\">\n<input class=\"h-4 w-4 accent-blue-600\" data-kid=\"3-1-2-1-2-2-1\" data-name=\"work type radio input\" name=\"work_type\" type=\"radio\" value=\"TJ Box\"/>\n            TJ Box\n          </label>\n</div>\n</fieldset>\n<section class=\"overflow-hidden rounded-xl border border-slate-200\" data-kid=\"3-1-2-2\" data-name=\"location map card\">\n<div class=\"flex items-center justify-between px-3 py-2.5\" data-kid=\"3-1-2-2-1\" data-name=\"map card header row\">\n<span class=\"flex items-center gap-1.5 text-[12px] font-semibold text-slate-800\" data-kid=\"3-1-2-2-1-1\" data-name=\"location label with icon\">\n<i class=\"ti ti-map-pin text-[15px] text-blue-700\" data-kid=\"3-1-2-2-1-1-1\" data-name=\"map pin icon\"></i>\n            লোকেশন\n          </span>\n<button class=\"flex items-center gap-1.5 rounded-lg bg-blue-600 px-2.5 py-1.5 text-[10.5px] font-semibold text-white shadow-sm\" data-kid=\"3-1-2-2-1-2\" data-name=\"current GPS capture button\" type=\"button\">\n<i class=\"ti ti-current-location text-[13px]\" data-kid=\"3-1-2-2-1-2-1\" data-name=\"current location crosshair icon\"></i>\n            বর্তমান GPS\n          </button>\n</div>\n<div class=\"relative\" data-kid=\"3-1-2-2-2\" data-name=\"map viewport container\">\n<div class=\"w-full\" data-kid=\"3-1-2-2-2-1\" data-name=\"interactive Leaflet map\" id=\"map\"></div>\n<span class=\"pointer-events-none absolute right-2 top-2 flex items-center gap-1 rounded-md bg-white/95 px-1.5 py-1 text-[9.5px] font-medium text-slate-600 shadow-sm ring-1 ring-slate-200\" data-kid=\"3-1-2-2-2-2\" data-name=\"map tap hint badge\">\n<i class=\"ti ti-hand-finger text-[11px] text-blue-700\" data-kid=\"3-1-2-2-2-2-1\" data-name=\"hand tap gesture icon\"></i>\n            ম্যাপে ট্যাপ করে বিন্দু বদলান\n          </span>\n</div>\n<div class=\"border-t border-dashed border-slate-300 bg-white px-3 py-2.5\" data-kid=\"3-1-2-2-3\" data-name=\"selected point coordinates panel\">\n<div class=\"flex items-center justify-between\" data-kid=\"3-1-2-2-3-1\" data-name=\"coordinates header row with label and accuracy\">\n<span class=\"flex items-center gap-1 text-[9.5px] font-semibold text-slate-400\" data-kid=\"3-1-2-2-3-1-1\" data-name=\"selected point label with icon\">\n<i class=\"ti ti-crosshair text-[12px]\" data-kid=\"3-1-2-2-3-1-1-1\" data-name=\"crosshair icon\"></i>\n              নির্বাচিত বিন্দু\n            </span>\n<span class=\"flex items-center gap-1 text-[9.5px] font-semibold text-emerald-700\" data-kid=\"3-1-2-2-3-1-2\" data-name=\"accuracy indicator with dot\">\n<span class=\"h-1.5 w-1.5 rounded-full bg-emerald-500\" data-kid=\"3-1-2-2-3-1-2-1\" data-name=\"accuracy status dot\"></span>\n              ±12 মিটার\n            </span>\n</div>\n<div class=\"mt-1.5 grid grid-cols-2\" data-kid=\"3-1-2-2-3-2\" data-name=\"coordinate values grid\">\n<div class=\"pr-3\" data-kid=\"3-1-2-2-3-2-1\" data-name=\"latitude value cell\">\n<p class=\"text-[9.5px] text-slate-400\" data-kid=\"3-1-2-2-3-2-1-1\" data-name=\"latitude label\">অক্ষাংশ</p>\n<p class=\"mono mt-0.5 text-[15px] font-semibold leading-none text-slate-900\" data-kid=\"3-1-2-2-3-2-1-2\" data-name=\"latitude degree value\">23.804915</p>\n</div>\n<div class=\"border-l border-slate-100 pl-3\" data-kid=\"3-1-2-2-3-2-2\" data-name=\"longitude value cell\">\n<p class=\"text-[9.5px] text-slate-400\" data-kid=\"3-1-2-2-3-2-2-1\" data-name=\"longitude label\">দ্রাঘিমাংশ</p>\n<p class=\"mono mt-0.5 text-[15px] font-semibold leading-none text-slate-900\" data-kid=\"3-1-2-2-3-2-2-2\" data-name=\"longitude degree value\">90.415812</p>\n</div>\n</div>\n</div>\n</section>\n<section class=\"rounded-xl border border-slate-200 px-3 py-2.5\" data-kid=\"3-1-2-3\" data-name=\"customer ID card with history\">\n<label class=\"block\" data-kid=\"3-1-2-3-1\" data-name=\"customer ID field wrapper\">\n<span class=\"text-[11px] font-semibold text-slate-700\" data-kid=\"3-1-2-3-1-1\" data-name=\"customer ID field label\">কাস্টমার ID</span>\n<span class=\"mt-1 flex items-center rounded-lg border border-slate-300 bg-white px-2.5 py-2\" data-kid=\"3-1-2-3-1-2\" data-name=\"customer ID input box\">\n<span class=\"mono text-[12px] font-medium text-slate-800\" data-kid=\"3-1-2-3-1-2-1\" data-name=\"customer ID text value\">CUS-1042</span>\n</span>\n</label>\n<div class=\"mt-2 flex items-center gap-1.5 rounded-md bg-slate-50 px-2 py-1.5 text-[9.5px] text-slate-500\" data-kid=\"3-1-2-3-2\" data-name=\"previous customer history row\">\n<i class=\"ti ti-history text-[12px]\" data-kid=\"3-1-2-3-2-1\" data-name=\"clock history icon\"></i>\n          সর্বশেষ\n          <span class=\"mono font-semibold text-slate-700\" data-kid=\"3-1-2-3-2-2\" data-name=\"previous customer ID value\">CUS-1041</span>\n<span class=\"ml-auto text-[9.5px] font-semibold text-blue-700 underline\" data-kid=\"3-1-2-3-2-3\" data-name=\"apply previous customer link\">ব্যবহার করুন</span>\n</div>\n</section>\n<details class=\"overflow-hidden rounded-xl border border-slate-200\" data-kid=\"3-1-2-4\" data-name=\"more options collapsible details section\" open=\"\">\n<summary class=\"flex cursor-pointer list-none items-center justify-between px-3 py-2.5 [&amp;::-webkit-details-marker]:hidden\" data-kid=\"3-1-2-4-1\" data-name=\"details section summary header\">\n<span class=\"flex items-center gap-1.5\" data-kid=\"3-1-2-4-1-1\" data-name=\"summary title and count badge\">\n<span class=\"text-[12px] font-semibold text-slate-800\" data-kid=\"3-1-2-4-1-1-1\" data-name=\"more options title text\">More options</span>\n<span class=\"rounded-full bg-slate-100 px-1.5 py-0.5 text-[9px] font-semibold text-slate-500\" data-kid=\"3-1-2-4-1-1-2\" data-name=\"field count badge\">৩টি ভরা</span>\n</span>\n<i class=\"ti ti-chevron-up text-[15px] text-slate-400\" data-kid=\"3-1-2-4-1-2\" data-name=\"chevron up icon\"></i>\n</summary>\n<div class=\"space-y-3.5 border-t border-slate-100 px-3 py-3\" data-kid=\"3-1-2-4-2\" data-name=\"details expanded content body\">\n<div data-kid=\"3-1-2-4-2-1\" data-name=\"ONU ID field group\">\n<p class=\"text-[11px] font-semibold text-slate-700\" data-kid=\"3-1-2-4-2-1-1\" data-name=\"ONU ID field label\">ONU ID / সিরিয়াল / MAC</p>\n<div class=\"mt-1 flex items-center rounded-lg border border-slate-300 bg-white px-2.5 py-2\" data-kid=\"3-1-2-4-2-1-2\" data-name=\"ONU ID input box\">\n<span class=\"mono text-[11.5px] font-medium text-slate-800\" data-kid=\"3-1-2-4-2-1-2-1\" data-name=\"ONU ID value text\">ZTEGC123456</span>\n</div>\n</div>\n<div data-kid=\"3-1-2-4-2-2\" data-name=\"customer name field group\">\n<p class=\"text-[11px] font-semibold text-slate-700\" data-kid=\"3-1-2-4-2-2-1\" data-name=\"customer name field label\">কাস্টমার নাম / রেফারেন্স</p>\n<div class=\"mt-1 flex items-center rounded-lg border border-slate-300 bg-white px-2.5 py-2\" data-kid=\"3-1-2-4-2-2-2\" data-name=\"customer name input box\">\n<span class=\"text-[11.5px] text-slate-700\" data-kid=\"3-1-2-4-2-2-2-1\" data-name=\"customer name value text\">মো. রফিকুল ইসলাম</span>\n</div>\n</div>\n<fieldset data-kid=\"3-1-2-4-2-3\" data-name=\"fiber meter reading fieldset\">\n<legend class=\"text-[11px] font-semibold text-slate-700\" data-kid=\"3-1-2-4-2-3-1\" data-name=\"fiber meter reading legend label\">ফাইবার রিডিং (মিটার)</legend>\n<div class=\"mt-1.5 grid grid-cols-2 gap-2\" data-kid=\"3-1-2-4-2-3-2\" data-name=\"meter reading start-end grid\">\n<div class=\"rounded-lg border border-slate-300 bg-white px-2.5 py-1.5\" data-kid=\"3-1-2-4-2-3-2-1\" data-name=\"start reading cell\">\n<p class=\"text-[9px] text-slate-500\" data-kid=\"3-1-2-4-2-3-2-1-1\" data-name=\"start reading label\">শুরু</p>\n<p class=\"mono mt-0.5 text-[12.5px] font-medium text-slate-800\" data-kid=\"3-1-2-4-2-3-2-1-2\" data-name=\"start reading value\">480</p>\n</div>\n<div class=\"rounded-lg border border-slate-300 bg-white px-2.5 py-1.5\" data-kid=\"3-1-2-4-2-3-2-2\" data-name=\"end reading cell\">\n<p class=\"text-[9px] text-slate-500\" data-kid=\"3-1-2-4-2-3-2-2-1\" data-name=\"end reading label\">শেষ</p>\n<p class=\"mono mt-0.5 text-[12.5px] font-medium text-slate-800\" data-kid=\"3-1-2-4-2-3-2-2-2\" data-name=\"end reading value\">516</p>\n</div>\n</div>\n<div class=\"mt-2 flex items-center justify-between rounded-lg bg-blue-50 px-2.5 py-1.5\" data-kid=\"3-1-2-4-2-3-3\" data-name=\"total used fiber calculation bar\">\n<span class=\"text-[10px] text-slate-600\" data-kid=\"3-1-2-4-2-3-3-1\" data-name=\"total used label\">মোট ব্যবহৃত</span>\n<span class=\"mono text-[12px] font-semibold text-blue-800\" data-kid=\"3-1-2-4-2-3-3-2\" data-name=\"total used fiber value\">36 মিটার</span>\n</div>\n</fieldset>\n<div data-kid=\"3-1-2-4-2-4\" data-name=\"notes field group\">\n<p class=\"text-[11px] font-semibold text-slate-700\" data-kid=\"3-1-2-4-2-4-1\" data-name=\"notes field label\">মন্তব্য / নোট</p>\n<div class=\"mt-1 flex min-h-[46px] items-start rounded-lg border border-slate-300 bg-white px-2.5 py-2 text-[11px] leading-relaxed text-slate-600\" data-kid=\"3-1-2-4-2-4-2\" data-name=\"notes text area\">ONU রিসেট করে চেক করা হয়েছে, সিগন্যাল ঠিক আছে।</div>\n</div>\n</div>\n</details>\n<div class=\"rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-2\" data-kid=\"3-1-2-5\" data-name=\"device info metadata card\">\n<div class=\"flex items-center gap-1.5\" data-kid=\"3-1-2-5-1\" data-name=\"device info header with icon\">\n<i class=\"ti ti-device-mobile text-[13px] text-slate-500\" data-kid=\"3-1-2-5-1-1\" data-name=\"mobile device icon\"></i>\n<span class=\"text-[9.5px] font-semibold text-slate-500\" data-kid=\"3-1-2-5-1-2\" data-name=\"device info description text\">এই এন্ট্রির সাথে ডিভাইস তথ্য যুক্ত হবে</span>\n</div>\n<div class=\"mt-1.5 grid grid-cols-3 divide-x divide-slate-200\" data-kid=\"3-1-2-5-2\" data-name=\"device info metrics grid\">\n<div class=\"pr-2\" data-kid=\"3-1-2-5-2-1\" data-name=\"device name metric cell\">\n<p class=\"text-[8.5px] text-slate-400\" data-kid=\"3-1-2-5-2-1-1\" data-name=\"device name label\">ডিভাইস</p>\n<p class=\"mono mt-0.5 text-[9.5px] font-medium text-slate-700\" data-kid=\"3-1-2-5-2-1-2\" data-name=\"device name value\">Galaxy A14</p>\n</div>\n<div class=\"px-2\" data-kid=\"3-1-2-5-2-2\" data-name=\"OS metric cell\">\n<p class=\"text-[8.5px] text-slate-400\" data-kid=\"3-1-2-5-2-2-1\" data-name=\"OS label\">OS</p>\n<p class=\"mono mt-0.5 text-[9.5px] font-medium text-slate-700\" data-kid=\"3-1-2-5-2-2-2\" data-name=\"OS version value\">Android 13</p>\n</div>\n<div class=\"pl-2\" data-kid=\"3-1-2-5-2-3\" data-name=\"browser metric cell\">\n<p class=\"text-[8.5px] text-slate-400\" data-kid=\"3-1-2-5-2-3-1\" data-name=\"browser label\">ব্রাউজার</p>\n<p class=\"mono mt-0.5 text-[9.5px] font-medium text-slate-700\" data-kid=\"3-1-2-5-2-3-2\" data-name=\"browser version value\">Chrome 142</p>\n</div>\n</div>\n<div class=\"mt-1.5 grid grid-cols-2 divide-x divide-slate-200 border-t border-slate-200 pt-1.5\" data-kid=\"3-1-2-5-3\" data-name=\"screen and IP metrics grid\">\n<div class=\"pr-2\" data-kid=\"3-1-2-5-3-1\" data-name=\"screen resolution metric cell\">\n<p class=\"text-[8.5px] text-slate-400\" data-kid=\"3-1-2-5-3-1-1\" data-name=\"screen label\">স্ক্রিন</p>\n<p class=\"mono mt-0.5 text-[9.5px] font-medium text-slate-700\" data-kid=\"3-1-2-5-3-1-2\" data-name=\"screen resolution value\">360×800 px</p>\n</div>\n<div class=\"pl-2\" data-kid=\"3-1-2-5-3-2\" data-name=\"IP address metric cell\">\n<p class=\"text-[8.5px] text-slate-400\" data-kid=\"3-1-2-5-3-2-1\" data-name=\"IP label\">IP</p>\n<p class=\"mono mt-0.5 text-[9.5px] font-medium text-slate-700\" data-kid=\"3-1-2-5-3-2-2\" data-name=\"IP address value\">103.108.24.51</p>\n</div>\n</div>\n</div>\n<button class=\"w-full rounded-xl bg-blue-600 py-3 text-[14px] font-bold text-white shadow-sm\" data-kid=\"3-1-2-6\" data-name=\"save submit button\" type=\"submit\">সেভ করুন</button>\n</form>\n</div>\n</div>\n<script src=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.js\"></script>\n<script>\n  (function () {\n    const point = [23.804915, 90.415812];\n    const map = L.map('map', { zoomControl: false, attributionControl: true, scrollWheelZoom: false }).setView(point, 17);\n    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '&copy; OpenStreetMap' }).addTo(map);\n    L.circle(point, { radius: 28, color: '#2563eb', weight: 1, opacity: 0.35, fillColor: '#2563eb', fillOpacity: 0.08 }).addTo(map);\n    L.circleMarker(point, { radius: 7, color: '#ffffff', weight: 3, fillColor: '#2563eb', fillOpacity: 1 }).addTo(map);\n  })();\n</script>",
