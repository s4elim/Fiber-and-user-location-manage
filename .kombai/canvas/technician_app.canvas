      "html": "<link data-kid=\"1\" data-name=\"tabler icons webfont stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');\n  .bn { font-family: 'Hind Siliguri', ui-sans-serif, system-ui, sans-serif; }\n  .mono { font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace; font-variant-numeric: tabular-nums; }\n</style>\n<div class=\"bn min-h-screen bg-slate-100 pb-8 text-slate-800\" data-kid=\"2\" data-name=\"page layout container\">\n<div class=\"mx-auto max-w-6xl px-5 py-5\" data-kid=\"2-1\" data-name=\"page content wrapper\">\n<header class=\"mb-4 flex flex-wrap items-start justify-between gap-3\" data-kid=\"2-1-1\" data-name=\"page header\">\n<div data-kid=\"2-1-1-1\" data-name=\"page title block\">\n<p class=\"text-[11.5px] font-medium text-blue-700\" data-kid=\"2-1-1-1-1\" data-name=\"panel subtitle label\">টেকনিশিয়ান প্যানেল</p>\n<h1 class=\"mt-0.5 text-[25px] font-bold leading-tight text-slate-900\" data-kid=\"2-1-1-1-2\" data-name=\"page headline\">কাজের লগ</h1>\n<p class=\"mt-0.5 flex items-center gap-1.5 text-[11px] text-slate-500\" data-kid=\"2-1-1-1-3\" data-name=\"total records summary row\">\n<i class=\"ti ti-database text-[12px]\" data-kid=\"2-1-1-1-3-1\" data-name=\"database icon\"></i>\n          মোট\n          <span class=\"mono font-semibold text-slate-700\" data-kid=\"2-1-1-1-3-2\" data-name=\"total record count value\">15</span>\n          টি রেকর্ড\n        </p>\n</div>\n<div class=\"flex gap-2\" data-kid=\"2-1-1-2\" data-name=\"header action buttons\">\n<a class=\"flex items-center gap-1.5 rounded-lg bg-blue-600 px-3.5 py-2 text-[11.5px] font-semibold text-white shadow-sm\" data-kid=\"2-1-1-2-1\" data-name=\"add new entry button\" href=\"#\">\n<i class=\"ti ti-plus text-[13px]\" data-kid=\"2-1-1-2-1-1\" d